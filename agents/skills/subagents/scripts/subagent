#!/usr/bin/env bash
# Launch a Subagent (for one Stage of a Work Item, or an ad-hoc task) in a Rex
# window, and close that window once its report is accepted.
#
# Usage:
#   subagent stages
#   subagent launch [--stage STAGE [--axis AXIS]] --item ITEM [--cwd DIR]
#                   [--harness HARNESS] [--model ROLE|MODEL] [--effort EFFORT] < BRIEF
#   subagent wait WINDOW [--idle-seconds N]
#   subagent close WINDOW
#   subagent ls
#   subagent cap [N|off]
#
# launch reads the brief on stdin and prints one JSON object on stdout:
#   {"name": ..., "window": ..., "block": ..., "report": ...}
# Everything else it prints goes to stderr.
#
# This must run on macOS's bash 3.2: no associative arrays, no ${var,,}.

set -eu

POLL_INTERVAL=0.25
STARTUP_POLLS=12 # three seconds the Rex child must survive to count as launched
REAP_GRACE=3    # seconds a leftover process gets between SIGINT and SIGTERM
REAP_POLL=0.2

# The prompt travels through a temp file because Rex rejects over-long
# commands. The child reads it, deletes it, then execs the agent with the
# prompt as its last argument; a trailing -- (where the harness supports it)
# keeps a prompt that starts with a dash from being read as an option.
# shellcheck disable=SC2016 # the child shell expands these, not this one.
CHILD_SCRIPT='if ! prompt=$(cat "$1"); then printf "%s\n" "[subagent] cannot read prompt file: $1" >&2; rm -f "$1"; exit 1; fi; rm -f "$1"; unset ANTIGRAVITY_CONVERSATION_ID ANTIGRAVITY_LS_ADDRESS ANTIGRAVITY_CSRF_TOKEN CLAUDECODE; export RECADO_ADDR="$0" RECADO_MANAGER="$2" GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true GIT_TERMINAL_PROMPT=0 GIT_PAGER=cat PAGER=cat GH_PROMPT_DISABLED=1; shift 2; exec "$@" "$prompt"'

# What every Subagent is told, Stage or ad-hoc: how it uses tools, and what on
# the machine is not its own.
HOUSE_RULES="Use the read and edit tools for files (not python heredocs or bash cat). Scope diffs and batched reads (\`git diff --stat\` first, bounded line ranges); in codemode, summarize or filter in JS so each call returns under ~10 KB (matching lines or <=80-line slices, never raw multi-file dumps). Start a server only on a port the OS picks (port 0), never on a fixed one; never stop a process you did not start; never print \`.env\` or another secrets file. Never use \`git stash\`: the stash is shared by every worktree of the repo; set work aside with a commit on your branch or a copy outside the repo."

# What every Stage Subagent is told, whichever Stage it runs.
SUBAGENT_RULES="The Manager runs the workflow; you run this one Stage and report. Open the report with a summary block of at most 10 lines: verdict (or outcome), what changed, must-fix count, decisions needed; then \`## \` sections carrying the detail. Send the Manager two kinds of message only: the completion report, and questions. The brief's done criterion is the whole bar: add no gate, check, or scope above it. A problem that behaves the same on the diff base goes in the report under \"Pre-existing\", one line each, never as a finding or a fix. A reversible implementation choice is yours to make: make it and list it under \"Choices made\" with its reason. Product and irreversible choices stay questions: ask, end your turn, and wait for the answer, which arrives as your next prompt. After you report, a new prompt from the Manager is a follow-up: apply it, update your report file, and report again. Delegating belongs to the Manager, so do every part of this Stage yourself. Reporting is part of every Stage, a read-only one included: run the reporting command even though it writes temporary files. Do not use intercom or your harness's built-in subagent, swarm, or messaging tools, do not poll, and do not read other sessions. $HOUSE_RULES"

# What an ad-hoc Subagent (launched without --stage) is told.
ADHOC_RULES="The calling agent coordinates the work; you run this task and report. Send it two kinds of message only: the completion report, and questions. A decision the brief leaves open is a question: ask it, end your turn, and wait for the answer, which arrives as your next prompt. After you report, a new prompt is a follow-up: apply it, update your report file, and report again. Do every part of this task yourself. Reporting is part of every task, a read-only one included: run the reporting command even though it writes temporary files. Do not use intercom or your harness's built-in subagent, swarm, or messaging tools, do not poll, and do not read other sessions. $HOUSE_RULES"

die() {
    printf '[subagent] %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Prepare and launch a Subagent in a Rex window.

Usage:
  subagent stages
      Print each Stage with its default harness, model, effort and skills.

  subagent launch [--stage STAGE [--axis AXIS]] --item ITEM [--cwd DIR]
                  [--harness HARNESS] [--model ROLE|MODEL] [--effort EFFORT] < BRIEF
      Build the prompt, open a Rex window in the caller's session, and print
      {"name", "window", "block", "report"} as JSON. The brief comes on stdin.
      --stage selects a Stage's skills, role prompt, and default model profile.
          Omit --stage for an ad-hoc Subagent with no Stage skills injected.
      --axis is required by --stage review, and rejected otherwise.
      --cwd defaults to the current directory.
      --harness overrides the harness: pi, agy, claude, or opencode.
      --model takes a role (builder, writer, critic) to swap the whole profile,
          or a harness-appropriate model id (e.g. provider/model for pi/opencode,
          gemini-4-neon-high for agy, opus or claude-sonnet-4-6 for claude).
      --effort overrides the thinking effort:
          off, minimal, low, medium, high, xhigh, or max.

  subagent wait WINDOW [--idle-seconds SECONDS]
      Wait until WINDOW's report file is non-empty and either a completion
      message arrives in recado inbox, the Subagent process exits, or the
      Subagent stays idle in recado agents for SECONDS (default 60). Prints
      {"window", "name", "report", "reason"} as JSON.

  subagent close WINDOW
      Close the Subagent's Rex window, then stop the processes the window
      left running in its worktree (SIGINT, then SIGTERM after 3 seconds),
      printing every pid and command it stopped. Only that window's own
      process tree is stopped.

  subagent ls
      List every open Subagent on this machine: name, Stage (- when ad-hoc),
      item, window, caller, and cwd. Subagents whose agent exited drop off.

  subagent cap [N|off]
      Print, set, or clear the machine-wide cap on open Stage Subagents.
      A Stage launch past the cap fails and lists the open ones; ad-hoc
      launches (Managers) are not counted.

REX_BLOCK identifies the caller's Rex terminal (resolved via rex whoami), and recado whoami the caller's address.
EOF
}

# ------------------------------------------------------------------ tables

load_stage() { # load_stage STAGE [AXIS]: load its skills, model role and prompt
    stage_axes=("")
    case $1 in
        research)
            skill_names='research why'
            model_role=builder
            role="You run the Research stage: you are the background agent the research skill describes, so do its job yourself. Change no files except the findings file."
            ;;
        build)
            skill_names='tdd coding'
            model_role=builder
            role="You run the Build stage: implement the brief, run lint, typecheck, and tests scoped to what you touched, and commit your work on the branch; for a bug, commit a failing regression test before the fix. The brief is your approved plan. Refine and Review are later Stages run by other Subagents — Review owns end-to-end surface verification and adversarial probing, so finish once the scoped automated gates are green and report the exact gate commands and outputs."
            ;;
        write)
            skill_names='writing-for-agents unslop'
            model_role=writer
            role="You run the Write stage: write the prose the brief asks for."
            ;;
        refine)
            skill_names='zero-tech-debt principles'
            model_role=critic
            role="You run the Refine stage: reshape the code this Work Item touched toward its intended design, keeping behaviour and tests green. Your scope is the diff since the brief's base, and the code it touches."
            ;;
        retro)
            skill_names='retro writing-for-agents'
            model_role=writer
            role="You run the Retro stage: conduct a read-only retrospective of the session the brief names and write your findings to the report file. Change no files except the report file."
            ;;
        review)
            skill_names=review
            model_role=critic
            stage_axes=(spec standards debt break)
            if [ "${2:-}" = break ]; then
                skill_names=interrogate
                role="You run the Review stage, break axis: you are the break-axis adversary the interrogate skill describes, so apply its brief yourself. Exercise the real surface a user touches (CLI, HTTP, or browser via the repo's \`verify-*\` skill when one exists). Change no files."
            else
                role="You run the Review stage, ${2:-} axis: you are the ${2:-} sub-agent the review skill describes, so apply its brief yourself. Change no files."
            fi
            ;;
        *) return 1 ;;
    esac
}

role_known() {
    case $1 in
        builder | writer | critic) return 0 ;;
        *) return 1 ;;
    esac
}

harness_known() {
    case $1 in
        pi | agy | claude | opencode) return 0 ;;
        *) return 1 ;;
    esac
}

effort_known() {
    case $1 in
        off | minimal | low | medium | high | xhigh | max) return 0 ;;
        *) return 1 ;;
    esac
}

model_value_known() { # model_value_known TEXT: non-empty, no whitespace
    case $1 in
        '' | *[[:space:]]*) return 1 ;;
        *) return 0 ;;
    esac
}

load_profile() { # load_profile ROLE: set profile_harness, profile_model, profile_effort
    case $1 in
        builder)
            profile_harness=agy
            profile_model=gemini-4-neon-low
            profile_effort=low
            ;;
        writer)
            profile_harness=agy
            profile_model=gemini-4-neon-medium
            profile_effort=medium
            ;;
        critic)
            profile_harness=pi
            profile_model=opencode-go/muse-spark-1.3-contributor
            profile_effort=max
            ;;
        *) return 1 ;;
    esac
}

print_stages() {
    for stage in research build write refine review retro; do
        load_stage "$stage"
        load_profile "$model_role"
        for axis in "${stage_axes[@]}"; do
            [ -z "$axis" ] || load_stage "$stage" "$axis"
            label=$stage
            [ -z "$axis" ] || label="$stage --axis $axis"
            printf '%-24s harness %-10s model %-36s effort %-8s skills %s\n' \
                "$label" "$profile_harness" "$profile_model" "$profile_effort" \
                "${skill_names// /, }"
        done
    done
}

check_axis() { # check_axis STAGE AXIS [AXIS_SET]
    case $1 in
        review)
            case $2 in
                spec | standards | debt | break) ;;
                '') die "--stage review needs --axis spec|standards|debt|break" ;;
                *) die "--stage review takes --axis spec|standards|debt|break, not $2" ;;
            esac
            ;;
        '')
            [ "${3:-0}" -eq 0 ] && [ -z "$2" ] || die "--axis requires --stage review"
            ;;
        *)
            [ "${3:-0}" -eq 0 ] && [ -z "$2" ] || die "--stage $1 takes no --axis"
            ;;
    esac
}

# ----------------------------------------------------------------- helpers

q() { # q TEXT: TEXT quoted for a shell command line
    printf '%q' "$1"
}

dq() { # dq TEXT: TEXT escaped for inside a double-quoted shell word
    printf '%s' "$1" | sed -e 's/[\\"$`]/\\&/g'
}

find_rex() {
    if command -v rex >/dev/null 2>&1; then
        command -v rex
    elif [ -n "${REX_BIN_DIR:-}" ] && [ -x "$REX_BIN_DIR/rex" ]; then
        printf '%s\n' "$REX_BIN_DIR/rex"
    else
        return 1
    fi
}

main_checkout() { # main_checkout DIR: checkout sharing DIR's git dir, '' outside git
    mc_common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
        mc_common=$(git -C "$1" rev-parse --git-common-dir 2>/dev/null) ||
        return 0
    case $mc_common in
        /*) ;;
        *) mc_common=$1/$mc_common ;;
    esac
    case ${mc_common%/*} in
        '') printf '%s\n' / ;;
        *) printf '%s\n' "${mc_common%/*}" ;;
    esac
}

main_root() { # main_root DIR: the main checkout of DIR, physical; '' when DIR is it
    mr_main=$(main_checkout "$1")
    [ -n "$mr_main" ] || return 0
    (cd "$mr_main" 2>/dev/null && pwd -P) || printf '%s\n' "$mr_main"
}

checkout_root() { # checkout_root DIR: DIR's git worktree top-level, physical
    cr_top=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) || cr_top=
    [ -n "$cr_top" ] || return 1
    (cd "$cr_top" 2>/dev/null && pwd -P)
}

skill_path() { # skill_path NAME CWD MAIN: the skill's SKILL.md, or nothing
    for root in "$2/.agents/skills" "$3/.agents/skills" \
        "$HOME/.agents/skills" "$HOME/.pi/agent/skills" "$HOME/.gemini/config/skills"; do
        if [ -f "$root/$1/SKILL.md" ]; then
            printf '%s\n' "$root/$1/SKILL.md"
            return 0
        fi
    done
    return 1
}

# close needs the worktree and block of the window it closes, and ls and the
# cap need who launched it and for what, so launch records them once per
# window, in a file of its own to keep concurrent launches off each other: cwd,
# block, name, Stage (- when ad-hoc), item, and caller, one per line. The
# record lives outside any checkout: the Manager often closes a window from a
# different repo than the one that launched it.
subagent_state_dir() {
    case ${XDG_STATE_HOME:-} in
        # XDG says a relative value is invalid, and honouring it would put the
        # record under whichever directory the caller happens to run in.
        /*) printf '%s/subagent/windows\n' "$XDG_STATE_HOME" ;;
        *) printf '%s/.local/state/subagent/windows\n' "$HOME" ;;
    esac
}

window_state_file() { # window_state_file WINDOW
    printf '%s/%s\n' "$(subagent_state_dir)" "$(printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_')"
}

record_window_state() { # record_window_state WINDOW CWD BLOCK NAME STAGE ITEM CALLER REPORT
    rs_file=$(window_state_file "$1")
    mkdir -p "${rs_file%/*}" || return 0
    printf '%s\n' "$2" "$3" "$4" "$5" "$6" "$7" "$8" >"$rs_file.$$" && mv "$rs_file.$$" "$rs_file"
}

subagent_home() { # the folder above the window records: the cap and the launch lock
    sh_dir=$(subagent_state_dir)
    printf '%s\n' "${sh_dir%/windows}"
}

take_lock() { # take_lock: hold the launch lock, taking over a dead holder's
    lock=$(subagent_home)/lock
    mkdir -p "$(subagent_home)"
    tries=0
    until mkdir "$lock" 2>/dev/null; do
        holder=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
            rm -rf "$lock"
            continue
        fi
        tries=$((tries + 1))
        [ "$tries" -lt 240 ] ||
            die "another launch has held $lock for a minute; remove it if no launch is running"
        sleep "$POLL_INTERVAL"
    done
    printf '%s\n' "$$" >"$lock/pid"
    locked=1
}

release_lock() {
    [ "${locked:-0}" -eq 1 ] || return 0
    rm -rf "$(subagent_home)/lock"
    locked=0
}

# open_records: one tab-separated line per Subagent whose agent still runs:
# name, Stage, item, caller, window, cwd. The record of an exited agent stays,
# since close still needs it to stop what the agent left running.
open_records() {
    for or_file in "$(subagent_state_dir)"/*; do
        [ -f "$or_file" ] || continue
        or_name=$(sed -n 3p "$or_file")
        [ -n "$or_name" ] || continue
        still_alive "$(sed -n 2p "$or_file")" || continue
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$or_name" "$(sed -n 4p "$or_file")" \
            "$(sed -n 5p "$or_file")" "$(sed -n 6p "$or_file")" "${or_file##*/}" \
            "$(sed -n 1p "$or_file")"
    done
}

print_records() { # print_records: records on stdin as aligned columns
    while IFS=$'\t' read -r r_name r_stage r_item r_caller r_window r_cwd; do
        printf '%-26s %-14s %-18s %-10s %s  %s\n' \
            "$r_name" "$r_stage" "$r_item" "$r_window" "$r_caller" "$r_cwd"
    done
}

still_alive() { # still_alive BLOCK: the agent started and is still running
    sa_state=$("$rex_cmd" --autostart=false block call -b "$1" process 2>/dev/null) || return 1
    [ -n "$sa_state" ] || return 1
    # last_exit stays null until the block's process exits.
    printf '%s' "$sa_state" | python3 -c 'import json, sys
try:
    last_exit = json.load(sys.stdin).get("last_exit")
except ValueError:
    sys.exit(1)
sys.exit(0 if last_exit is None else 1)'
}

# ------------------------------------------------------------------ launch

cmd_launch() {
    stage=
    axis=
    axis_set=0
    item=
    cwd=
    override_harness=
    override_harness_set=0
    override_model=
    override_model_set=0
    override_effort=
    override_effort_set=0
    while [ $# -gt 0 ]; do
        flag=
        value=
        case $1 in
            --stage | --axis | --item | --cwd | --harness | --model | --effort)
                [ $# -ge 2 ] || die "launch: $1 needs a value"
                flag=$1
                value=$2
                shift 2
                ;;
            --stage=* | --axis=* | --item=* | --cwd=* | --harness=* | --model=* | --effort=*)
                flag=${1%%=*}
                value=${1#*=}
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            *) die "launch: unexpected argument: $1" ;;
        esac
        case $flag in
            --stage) stage=$value ;;
            --axis) axis=$value; axis_set=1 ;;
            --item) item=$value ;;
            --cwd) cwd=$value ;;
            --harness) override_harness=$value; override_harness_set=1 ;;
            --model) override_model=$value; override_model_set=1 ;;
            --effort) override_effort=$value; override_effort_set=1 ;;
        esac
    done

    [ -n "$item" ] || die "launch needs --item"
    if [ -n "$stage" ]; then
        load_stage "$stage" "$axis" || die "unknown stage: $stage; see \`subagent stages\`"
        check_axis "$stage" "$axis" "$axis_set"
        load_profile "$model_role"
        rules=$SUBAGENT_RULES
    else
        check_axis '' "$axis" "$axis_set"
        skill_names=
        role="You are a Subagent running an ad-hoc task for the calling agent. Follow the brief and report back when done."
        load_profile builder
        rules=$ADHOC_RULES
    fi

    harness=$profile_harness
    model=$profile_model
    effort=$profile_effort

    if [ "$override_model_set" -eq 1 ]; then
        if role_known "$override_model"; then
            load_profile "$override_model"
            harness=$profile_harness
            model=$profile_model
            effort=$profile_effort
        elif model_value_known "$override_model"; then
            model=$override_model
        else
            [ -n "$override_model" ] || override_model='an empty value'
            die "--model takes a role (builder, writer, critic) or a non-empty model id without whitespace, not $override_model"
        fi
    fi

    if [ "$override_harness_set" -eq 1 ]; then
        if harness_known "$override_harness"; then
            harness=$override_harness
        else
            [ -n "$override_harness" ] || override_harness='an empty value'
            die "--harness takes pi, agy, claude, or opencode, not $override_harness"
        fi
    fi

    if [ "$override_effort_set" -eq 1 ]; then
        if effort_known "$override_effort"; then
            effort=$override_effort
        else
            [ -n "$override_effort" ] || override_effort='an empty value'
            die "--effort takes off, minimal, low, medium, high, xhigh, or max, not $override_effort"
        fi
    fi

    brief=$(cat)
    cwd=$(CDPATH='' cd "${cwd:-$PWD}" && pwd -P) || die "cwd is not a directory: ${cwd:-$PWD}"
    main=$(main_checkout "$cwd")
    [ -n "$main" ] || main=$cwd

    # Fail before anything launches when a Stage's skill is not installed.
    missing=
    skills=
    for name in $skill_names; do
        if ! path=$(skill_path "$name" "$cwd" "$main"); then
            missing="$missing $name"
            continue
        fi
        skills="$skills- $name: $path
"
    done
    [ -z "$missing" ] || die "skills not installed for $cwd:$missing"

    rex_cmd=$(find_rex) || die "rex not found on PATH or in REX_BIN_DIR"
    [ -n "${REX_BLOCK:-}" ] ||
        die "REX_BLOCK is not set; run from a Rex terminal"
    rex_whoami=$("$rex_cmd" --autostart=false whoami --json 2>/dev/null) ||
        die "rex whoami failed; run from a live Rex terminal"
    rex_session=$(printf '%s' "$rex_whoami" | python3 -c 'import json, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
sid = data.get("session_id") if isinstance(data, dict) else None
if not isinstance(sid, str) or not sid:
    sys.exit(1)
print(sid)') ||
        die "rex whoami did not return a session_id; run from a live Rex terminal"
    command -v recado >/dev/null 2>&1 ||
        die "recado is not on PATH; install it and run recado skill setup"
    manager=$(recado whoami 2>/dev/null) ||
        die "recado whoami cannot identify the caller; run recado skill setup and restart the session"
    [ -n "$manager" ] ||
        die "recado whoami cannot identify the caller; run recado skill setup and restart the session"

    # Count and claim a place under one lock, so two Managers launching at
    # once cannot both take the last one.
    take_lock
    trap release_lock EXIT
    cap_file=$(subagent_home)/cap
    if [ -n "$stage" ] && [ -f "$cap_file" ]; then
        cap=$(cat "$cap_file")
        open_stage=$(open_records | awk -F '\t' '$2 != "-"')
        count=$(printf '%s' "$open_stage" | grep -c . || true)
        [ "$count" -lt "$cap" ] ||
            die "$count of $cap Stage Subagents are open, the cap \`subagent cap\` set; launch once one is closed:
$(printf '%s\n' "$open_stage" | print_records)"
    fi

    if [ -n "$stage" ]; then
        stage_label=$stage
        [ -z "$axis" ] || stage_label="$stage $axis"
        name="subagent-$stage-$$"
        tag="$name · $item · $stage_label"
        report_name=$item-$stage
        [ -z "$axis" ] || report_name=$report_name-$axis
    else
        name="subagent-adhoc-$$"
        tag="$name · $item"
        report_name=$item
    fi

    report_dir="$main/.agents/reports"
    report=$report_dir/$report_name.md
    if [ -e "$report" ]; then
        round=2
        while [ -e "$report_dir/$report_name-r$round.md" ]; do
            round=$((round + 1))
        done
        report=$report_dir/$report_name-r$round.md
    fi
    mkdir -p "$report_dir"

    send_cmd="recado send \"\$RECADO_MANAGER\" --kind complete"
    send_cmd="$send_cmd --meta $(q "item=$item")"
    [ -z "$stage" ] || send_cmd="$send_cmd --meta $(q "stage=$stage")"
    [ -z "$axis" ] || send_cmd="$send_cmd --meta $(q "axis=$axis")"
    send_cmd="$send_cmd --meta $(q "report=$report")"

    prompt=$role
    prompt="$prompt

You are $tag. Start every message to the caller with [$tag], exactly as written here; it is the [TAG] in the commands below."
    if [ -n "$skills" ]; then
        prompt="$prompt
Read and follow these skills:
$skills"
    fi
    prompt="$prompt
Write your full report to $report; the completion report is one line pointing at it.
Report through recado to $manager (\`\$RECADO_MANAGER\` in your environment). Its send and ask commands below are the complete route. Ask if the reporting command fails.
Run these exact commands to report and to ask (the address and tag are already filled in; never retype them):
$send_cmd \"[$(dq "$tag")] TASK COMPLETE: <one line>\"
recado ask \"\$RECADO_MANAGER\" \"[$(dq "$tag")] QUESTION: <question>\"

$rules

$brief"

    prompt_file=$(mktemp "${TMPDIR:-/tmp}/$name.XXXXXX")
    printf '%s\n' "$prompt" >"$prompt_file"
    trap 'rm -f "$prompt_file" "$prompt_file.err"; release_lock' EXIT

    case $harness in
        pi)
            agent_cmd=(pi --append-system-prompt "$role" --model "$model" --thinking "$effort" --)
            ;;
        agy)
            agent_cmd=(agy --model "$model" --effort "$effort" --mode auto -i)
            ;;
        claude)
            agent_cmd=(claude --append-system-prompt "$role" --model "$model" --effort "$effort" --permission-mode auto --)
            ;;
        opencode)
            agent_cmd=(opencode mini --model "$model" --prompt)
            ;;
    esac

    printf '[subagent] %s harness %s model %s effort %s\n' "$name" "$harness" "$model" "$effort" >&2
    created=$(
        "$rex_cmd" --autostart=false window new \
            -s "$rex_session" "$name" -c "$cwd" \
            --focus=false --keep-open --shell=none --json \
            -- "${SHELL:-/bin/sh}" -lc "$CHILD_SCRIPT" "$name" "$prompt_file" "$manager" \
            "${agent_cmd[@]}" \
            2>"$prompt_file.err"
    ) || die "rex window new failed: $(cat "$prompt_file.err")
check \`$rex_cmd window ls -s $rex_session\` for a window named $name and close it before relaunching"
    rm -f "$prompt_file.err"
    trap release_lock EXIT

    window=$(printf '%s' "$created" | python3 -c 'import json, sys
print(json.load(sys.stdin)["window_id"])') || die "cannot read rex window new output: $created"
    block=$(printf '%s' "$created" | python3 -c 'import json, sys
print(json.load(sys.stdin)["block_ids"][0])') || die "cannot read rex window new output: $created"
    printf '[subagent] %s window %s block %s\n' "$name" "$window" "$block" >&2
    record_window_state "$window" "$cwd" "$block" "$name" "${stage_label:--}" "$item" "$manager" "$report" ||
        printf '[subagent] cannot record %s; close cannot reap it\n' "$window" >&2
    release_lock
    trap - EXIT

    alive=1
    for ((poll = 0; poll < STARTUP_POLLS; poll++)); do
        if ! still_alive "$block"; then
            alive=0
            break
        fi
        sleep "$POLL_INTERVAL"
    done
    if [ "$alive" -eq 1 ]; then
        still_alive "$block" || alive=0
    fi
    if [ "$alive" -eq 0 ]; then
        rm -f "$prompt_file"
        tailview=$("$rex_cmd" --autostart=false capture -b "$block" --trim --unwrap 2>/dev/null || true)
        printf '%s\n' "$tailview" | tail -n 15 >&2
        die "agent start failed for $name; window $window is left open"
    fi

    python3 -c 'import json, sys
print(json.dumps(dict(zip(("name", "window", "block", "report"), sys.argv[1:])), separators=(",", ":")))' \
        "$name" "$window" "$block" "$report"
}

# ------------------------------------------------------------------- close

# A process that outlives its Rex window still belongs to the window's process
# tree, and still has its cwd inside the worktree. Both are required, so closing
# one window cannot disturb another Subagent sharing the worktree, the Manager's
# own checks, or anything outside the worktree.
self_and_parents() { # self_and_parents: pids close must never signal
    sp_pid=$$
    while [ "$sp_pid" -gt 1 ]; do
        printf '%s\n' "$sp_pid"
        sp_pid=$(ps -o ppid= -p "$sp_pid" 2>/dev/null | tr -d ' ')
        [ -n "$sp_pid" ] || break
    done
}

cwd_pids() { # cwd_pids DIR: pids whose cwd is DIR or below it
    if command -v lsof >/dev/null 2>&1; then
        # Through the environment, not awk -v: a path holding a backslash
        # would be read as an escape sequence. lsof's -F output doubles a
        # backslash, so compare in its terms.
        cp_dir=$(printf '%s' "$1" | sed 's/\\/\\\\/g')
        export cp_dir
        lsof -a -d cwd -Fpn 2>/dev/null | awk '
            BEGIN { dir = ENVIRON["cp_dir"] }
            /^p/ { pid = substr($0, 2); next }
            /^n/ {
                path = substr($0, 2)
                if (path == dir || index(path, dir "/") == 1) print pid
            }'
        return 0
    fi
    for cp_entry in /proc/[0-9]*/cwd; do
        cp_path=$(readlink "$cp_entry" 2>/dev/null) || continue
        cp_path=${cp_path% (deleted)}
        case $cp_path in
            "$1" | "$1"/*) printf '%s\n' "${cp_entry#/proc/}" | sed 's|/cwd$||' ;;
        esac
    done
}

descendants() { # descendants PID: PID and every process below it, as ps sees now
    case $1 in '' | *[!0-9]*) return 1 ;; esac
    dc_out=$(ps -axo pid=,ppid= 2>/dev/null | awk -v root="$1" '
        { kids[$2] = kids[$2] " " $1 }
        END {
            seen[root] = 1
            print root
            stack[1] = root
            top = 1
            while (top > 0) {
                pid = stack[top]
                top--
                n = split(kids[pid], child, " ")
                for (i = 1; i <= n; i++) {
                    if (child[i] == "" || (child[i] in seen)) continue
                    seen[child[i]] = 1
                    print child[i]
                    stack[++top] = child[i]
                }
            }
        }') || return 1
    # Every pid has to be a positive integer: anything else is not a process
    # this close may signal.
    for dc_pid in $dc_out; do
        case $dc_pid in '' | *[!0-9]*) return 1 ;; esac
    done
    printf '%s\n' "$dc_out"
}

group_peers() { # group_peers "PIDS": PIDS plus same-pgid/session peers outside self_and_parents' groups
    gp_seeds=$1
    gp_keep=$(self_and_parents)
    gp_use_sess=0
    if [ "$(uname -s)" = Linux ]; then
        gp_use_sess=1
        gp_ps=$(ps -axo pid=,pgid=,sess= 2>/dev/null) || return 1
    else
        # macOS BSD ps -o sess= prints a kernel pointer rather than a session id.
        gp_ps=$(ps -axo pid=,pgid= 2>/dev/null) || return 1
    fi
    gp_out=$(printf '%s\n' "$gp_ps" | awk -v seeds="$gp_seeds" -v keep="$gp_keep" -v use_sess="$gp_use_sess" '
        BEGIN {
            n = split(seeds, arr, /[[:space:]]+/)
            for (i = 1; i <= n; i++) {
                if (arr[i] != "") {
                    seed[arr[i]] = 1
                    seen[arr[i]] = 1
                    print arr[i]
                }
            }
            n = split(keep, arr, /[[:space:]]+/)
            for (i = 1; i <= n; i++) {
                if (arr[i] != "") kept[arr[i]] = 1
            }
            blocked_pgid["0"] = 1
            blocked_pgid["1"] = 1
            blocked_sess["0"] = 1
            blocked_sess["1"] = 1
        }
        {
            p = $1
            g = $2
            s = (use_sess ? $3 : "")
            if (p !~ /^[0-9]+$/) next
            pids[++count] = p
            pgid[p] = g
            if (use_sess) sess[p] = s
            if (p in kept) {
                if (g ~ /^[0-9]+$/) blocked_pgid[g] = 1
                if (use_sess && s ~ /^[0-9]+$/) blocked_sess[s] = 1
            }
        }
        END {
            for (p in seed) {
                g = pgid[p]
                if (g ~ /^[0-9]+$/ && !(g in blocked_pgid)) target_pgid[g] = 1
                if (use_sess) {
                    s = sess[p]
                    if (s ~ /^[0-9]+$/ && !(s in blocked_sess)) target_sess[s] = 1
                }
            }
            for (i = 1; i <= count; i++) {
                p = pids[i]
                if (p in seen) continue
                g = pgid[p]
                s = sess[p]
                if ((g in target_pgid) || (use_sess && (s in target_sess))) {
                    seen[p] = 1
                    print p
                }
            }
        }') || return 1
    for gp_pid in $gp_out; do
        case $gp_pid in '' | *[!0-9]*) return 1 ;; esac
    done
    printf '%s\n' "$gp_out"
}

window_pids() { # window_pids BLOCK: the pids in that window's process tree and group/session
    wp_json=$("$rex_cmd" --autostart=false block call -b "$1" process 2>/dev/null) || return 1
    # The field has to be a JSON integer above zero: null, true, and a string
    # such as "123\n" are not process ids, and command substitution would strip
    # the newline before the shell could tell the string from the number.
    wp_pid=$(printf '%s' "$wp_json" | python3 -c 'import json, sys
try:
    pid = json.load(sys.stdin)["child"]["pid"]
except (ValueError, KeyError, TypeError):
    sys.exit(1)
if isinstance(pid, bool) or not isinstance(pid, int) or pid <= 0:
    sys.exit(1)
print(pid)' 2>/dev/null) || return 1
    wp_pids=$(descendants "$wp_pid") || return 1
    group_peers "$wp_pids"
}

reap_wait() { # reap_wait "PIDS" SECONDS: the pids still alive when it ends
    rw_deadline=$(($(date +%s) + $2))
    while [ "$(date +%s)" -lt "$rw_deadline" ]; do
        rw_live=
        for rw_pid in $1; do
            if kill -0 "$rw_pid" 2>/dev/null; then
                rw_live="$rw_live $rw_pid"
            fi
        done
        [ -n "$rw_live" ] || return 0
        sleep "$REAP_POLL"
    done
    printf '%s\n' "$rw_live"
}

reap_worktree() { # reap_worktree DIR "PIDS": stop those alive in DIR
    reap_root=$1
    reap_tree=$2
    reap_keep=$(self_and_parents)
    reap_inside=$(cwd_pids "$reap_root")
    reap_list=$(mktemp "${TMPDIR:-/tmp}/subagent-reap.XXXXXX")
    reap_pids=
    for reap_pid in $reap_tree; do
        case "
$reap_keep
" in *"
$reap_pid
"*) continue ;; esac
        case "
$reap_inside
" in *"
$reap_pid
"*) ;; *) continue ;; esac
        reap_cmd=$(ps -o command= -p "$reap_pid" 2>/dev/null | cut -c1-70) || reap_cmd=
        printf '%s\t%s\n' "$reap_pid" "$reap_cmd" >>"$reap_list"
        reap_pids="$reap_pids $reap_pid"
    done
    if [ -z "$reap_pids" ]; then
        rm -f "$reap_list"
        printf '[subagent] no processes of this window left in %s\n' "$reap_root" >&2
        return 0
    fi
    for reap_pid in $reap_pids; do
        kill -INT "$reap_pid" 2>/dev/null || true
    done
    reap_live=$(reap_wait "$reap_pids" "$REAP_GRACE")
    # A process that left the boundary while it had the grace period is no
    # longer this worktree's business, so escalate only those still inside it.
    reap_here=
    reap_left=
    if [ -n "$reap_live" ]; then
        reap_still=$(cwd_pids "$reap_root")
        for reap_pid in $reap_live; do
            case "
$reap_still
" in *"
$reap_pid
"*) reap_here="$reap_here $reap_pid" ;; *) reap_left="$reap_left $reap_pid" ;; esac
        done
    fi
    for reap_pid in $reap_left; do
        printf '[subagent] pid %s left %s; not terminating it\n' "$reap_pid" "$reap_root" >&2
    done
    for reap_pid in $reap_here; do
        kill -TERM "$reap_pid" 2>/dev/null || true
    done
    [ -z "$reap_here" ] || reap_wait "$reap_here" "$REAP_GRACE" >/dev/null
    while IFS="$(printf '\t')" read -r reap_pid reap_cmd; do
        case " $reap_left " in *" $reap_pid "*) continue ;; esac
        if kill -0 "$reap_pid" 2>/dev/null; then
            printf '[subagent] pid %s survived SIGTERM (%s)\n' "$reap_pid" "$reap_cmd" >&2
        else
            printf '[subagent] stopped pid %s (%s)\n' "$reap_pid" "$reap_cmd" >&2
        fi
    done <"$reap_list"
    rm -f "$reap_list"
}

cmd_close() {
    [ $# -eq 1 ] || die "close needs exactly one WINDOW"
    window=$1
    rex_cmd=$(find_rex) || die "rex not found on PATH or in REX_BIN_DIR"

    # Snapshot the window's process tree before Rex tears the window down.
    worktree=
    boundary=
    tree=
    tree_known=1
    state_file=$(window_state_file "$window")
    if [ -f "$state_file" ]; then
        worktree=$(sed -n 1p "$state_file")
        block=$(sed -n 2p "$state_file")
        if [ -n "$worktree" ] && [ -d "$worktree" ] && [ -n "$block" ]; then
            # lsof and /proc report physical paths, so compare in the same terms.
            worktree=$(cd "$worktree" && pwd -P)
            # The boundary is the worktree the launch cwd belongs to, not the
            # cwd itself: a launch from a subdirectory still owns the whole
            # worktree, and a launch from the main checkout owns nothing.
            boundary=$(checkout_root "$worktree") || boundary=$worktree
            tree=$(window_pids "$block") || tree_known=0
        else
            worktree=
        fi
    fi

    # A close Rex refuses is not an already-gone window: keep the record so it
    # can be retried, and signal nothing while that window may still be alive.
    # Only rex's own exit 3 with the window-target wording means the window was
    # already gone; a "not found" inside any other error is a refusal too.
    close_status=0
    close_output=$("$rex_cmd" --autostart=false window close "$window" 2>&1) || close_status=$?
    if [ "$close_status" -eq 0 ]; then
        printf '[subagent] closed window %s\n' "$window" >&2
    elif [ "$close_status" -eq 3 ] &&
        printf '%s' "$close_output" | grep -Eqi 'window target .*not found'; then
        printf '[subagent] window %s is already gone\n' "$window" >&2
    else
        printf '[subagent] rex could not close window %s: %s\n' "$window" "$close_output" >&2
        printf '[subagent] kept record %s; stopped nothing\n' "$state_file" >&2
        return 1
    fi
    rm -f "$state_file"

    if [ -z "$worktree" ]; then
        printf '[subagent] no worktree recorded for %s; nothing to reap\n' "$window" >&2
        return 0
    fi
    if [ "$boundary" = "$(main_root "$boundary")" ]; then
        printf '[subagent] %s ran in the main checkout %s; not reaping its processes\n' \
            "$window" "$boundary" >&2
        return 0
    fi
    if [ "$tree_known" -eq 0 ]; then
        printf '[subagent] cannot read the process tree of %s (is rex reachable?); not reaping\n' \
            "$window" >&2
        return 0
    fi
    reap_worktree "$boundary" "$tree"
}

# -------------------------------------------------------------------- wait

wait_inbox_complete() { # wait_inbox_complete CALLER NAME REPORT
    wi_json=$(recado inbox --as "$1" --json 2>/dev/null) || return 1
    [ -n "$wi_json" ] || return 1
    printf '%s' "$wi_json" | python3 -c 'import json, sys
name, report = sys.argv[1], sys.argv[2]
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
msgs = data.get("messages") if isinstance(data, dict) else data
for m in (msgs or []):
    if not isinstance(m, dict):
        continue
    sender = str(m.get("from") or m.get("sender") or "")
    from_name = str(m.get("from_name") or "")
    if not (sender == name or sender.endswith("/" + name) or from_name == name):
        continue
    meta = m.get("meta") if isinstance(m.get("meta"), dict) else {}
    if m.get("kind") == "complete" or meta.get("report") == report:
        sys.exit(0)
sys.exit(1)' "$2" "$3"
}

wait_agent_idle() { # wait_agent_idle NAME
    wa_json=$(recado agents --json 2>/dev/null) || return 1
    [ -n "$wa_json" ] || return 1
    printf '%s' "$wa_json" | python3 -c 'import json, sys
name = sys.argv[1]
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
agents = data.get("agents") if isinstance(data, dict) else data
for a in (agents or []):
    if not isinstance(a, dict):
        continue
    addr = str(a.get("address") or "")
    aname = str(a.get("name") or "")
    if (aname == name or addr == name or addr.endswith("/" + name)) and a.get("state") == "idle":
        sys.exit(0)
sys.exit(1)' "$1"
}

cmd_wait() {
    window=
    idle_seconds=60
    while [ $# -gt 0 ]; do
        case $1 in
            --idle-seconds)
                [ $# -ge 2 ] || die "wait: --idle-seconds needs a value"
                case $2 in
                    '' | *[!0-9]*) die "wait: --idle-seconds takes a non-negative integer, not $2" ;;
                esac
                idle_seconds=$2
                shift 2
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            -*)
                die "wait: unexpected option: $1"
                ;;
            *)
                [ -z "$window" ] || die "wait: unexpected argument: $1"
                window=$1
                shift
                ;;
        esac
    done
    [ -n "$window" ] || die "wait needs a WINDOW"

    rex_cmd=$(find_rex) || die "rex not found on PATH or in REX_BIN_DIR"
    state_file=$(window_state_file "$window")
    [ -f "$state_file" ] || die "unknown window: $window"

    block=$(sed -n 2p "$state_file")
    name=$(sed -n 3p "$state_file")
    caller=$(sed -n 6p "$state_file")
    report=$(sed -n 7p "$state_file")
    [ -n "$block" ] && [ -n "$name" ] && [ -n "$caller" ] && [ -n "$report" ] ||
        die "incomplete window state for $window"

    poll_interval=${SUBAGENT_WAIT_POLL:-2}
    idle_since=
    reason=
    while :; do
        alive=1
        still_alive "$block" || alive=0
        if [ ! -s "$report" ]; then
            if [ "$alive" -eq 0 ]; then
                die "subagent $name ($window) exited without writing report $report"
            fi
            idle_since=
            sleep "$poll_interval"
            continue
        fi
        if wait_inbox_complete "$caller" "$name" "$report"; then
            reason=inbox
            break
        fi
        if [ "$alive" -eq 0 ]; then
            reason=exited
            break
        fi
        if wait_agent_idle "$name"; then
            now=$(date +%s)
            [ -n "$idle_since" ] || idle_since=$now
            if [ $((now - idle_since)) -ge "$idle_seconds" ]; then
                reason=idle
                break
            fi
        else
            idle_since=
        fi
        sleep "$poll_interval"
    done

    python3 -c 'import json, sys
print(json.dumps(dict(zip(("window", "name", "report", "reason"), sys.argv[1:])), separators=(",", ":")))' \
        "$window" "$name" "$report" "$reason"
}

# ---------------------------------------------------------------- ls & cap

cmd_ls() {
    [ $# -eq 0 ] || die "ls takes no arguments"
    rex_cmd=$(find_rex) || die "rex not found on PATH or in REX_BIN_DIR"
    open_records | print_records
}

cmd_cap() {
    cap_file=$(subagent_home)/cap
    case $# in
        0)
            if [ -f "$cap_file" ]; then cat "$cap_file"; else printf 'off\n'; fi
            ;;
        1)
            case $1 in
                off) rm -f "$cap_file" ;;
                '' | *[!0-9]* | 0) die "cap takes a positive number or off, not $1" ;;
                *)
                    mkdir -p "$(subagent_home)"
                    printf '%s\n' "$1" >"$cap_file"
                    ;;
            esac
            ;;
        *) die "cap takes a positive number or off" ;;
    esac
}

# -------------------------------------------------------------------- main

command_name=${1-}
shift || true
case $command_name in
    stages)
        [ $# -eq 0 ] || die "stages takes no arguments"
        print_stages
        ;;
    launch) cmd_launch "$@" ;;
    wait) cmd_wait "$@" ;;
    close) cmd_close "$@" ;;
    ls) cmd_ls "$@" ;;
    cap) cmd_cap "$@" ;;
    help | -h | --help) usage ;;
    '')
        usage >&2
        exit 2
        ;;
    *)
        usage >&2
        die "unknown command: $command_name"
        ;;
esac
