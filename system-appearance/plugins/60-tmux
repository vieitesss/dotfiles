#!/bin/sh
# Reload tmux, passing the target mode explicitly so the config cannot race
# macOS while its appearance preference is still propagating. Linux has no
# appearance setting, so also persist the mode where tmux.conf reads it there.
# source-file does not always repaint clients after an external reload, so
# force each one to redraw. remote/tmux links here, so this also runs on each
# remote host.
set -eu

mode=$1
mkdir -p "$HOME/.local/state"
printf '%s\n' "$mode" > "$HOME/.local/state/system-appearance"
if tmux list-sessions >/dev/null 2>&1; then
    tmux set-environment -g SYSTEM_APPEARANCE "$mode"
    tmux source-file "$HOME/.tmux.conf"
    tmux set-environment -gu SYSTEM_APPEARANCE
    tmux list-clients -F '#{client_tty}' | while read -r client; do
        tmux refresh-client -t "$client" -S
    done
fi
