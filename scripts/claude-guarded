#!/bin/sh
# Launch Claude Code with the tmux risk guard attached: claude-guarded [ARGS...]
# Deliberately not a `claude` alias: the real binary stays in reach and
# ~/.claude/settings.json is untouched.  The --settings JSON comes from this
# checkout's scripts/tmux-guard, so policy and guard path have one owner.

set -eu

target=$0
while [ -L "$target" ]; do
    base=$(CDPATH='' cd "$(dirname "$target")" && pwd -P)
    target=$(readlink "$target")
    case $target in
        /*) ;;
        *) target=$base/$target ;;
    esac
done
repo=$(CDPATH='' cd "$(dirname "$target")/.." && pwd -P)
guard=$repo/scripts/tmux-guard

[ -x "$guard" ] || { echo "claude-guarded: guard is not executable: $guard" >&2; exit 2; }
command -v claude >/dev/null 2>&1 || { echo "claude-guarded: claude not found on PATH" >&2; exit 2; }
settings=$("$guard" --claude-settings) || {
    echo "claude-guarded: could not build the guard settings" >&2
    exit 2
}
exec claude --settings "$settings" "$@"
