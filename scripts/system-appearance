#!/bin/sh

# Switch every themed element between light and dark. Each element is an
# executable plugin in $SYSTEM_APPEARANCE_DIR/plugins, run in name order with
# the mode as its only argument; add or delete a file to add or drop an
# element. A failing plugin is reported and the rest still run.

set -eu

# GUI launchers such as Hammerspoon inherit macOS's minimal PATH rather than
# the interactive shell's PATH. Include managed and Homebrew binaries so the
# plugins behave identically from the keyboard shortcut.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:$PATH"
export PATH

SYSTEM_APPEARANCE_DIR=${SYSTEM_APPEARANCE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/system-appearance}
export SYSTEM_APPEARANCE_DIR

if [ "$(uname -s)" != Darwin ]; then
    echo "system-appearance currently supports macOS only" >&2
    exit 1
fi

case "${1:-}" in
    light|dark)
        mode=$1
        ;;
    toggle)
        if osascript -e 'tell application "System Events" to tell appearance preferences to get dark mode' | grep -q true; then
            mode=light
        else
            mode=dark
        fi
        ;;
    *)
        echo "Usage: $(basename "$0") light|dark|toggle" >&2
        exit 2
        ;;
esac

plugins_dir="$SYSTEM_APPEARANCE_DIR/plugins"
if [ ! -d "$plugins_dir" ]; then
    echo "ERROR: plugin directory not found: $plugins_dir" >&2
    exit 1
fi

failed=0
for plugin in "$plugins_dir"/*; do
    if [ ! -f "$plugin" ] || [ ! -x "$plugin" ]; then
        continue
    fi
    if "$plugin" "$mode"; then
        :
    else
        status=$?
        echo "ERROR: plugin $(basename "$plugin") failed (exit $status)" >&2
        failed=1
    fi
done

printf 'System appearance: %s\n' "$mode"
exit "$failed"
