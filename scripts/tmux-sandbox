#!/usr/bin/env python3
"""Run commands against a private, owned tmux server.

Usage:
    tmux-sandbox new [--state DIR]
    tmux-sandbox path --state DIR
    tmux-sandbox run [--state DIR] [--keep] -- CMD [ARGS...]
    tmux-sandbox cleanup --state DIR

``run`` creates a unique state directory under the temporary directory with its
own socket, unsets the inherited TMUX/TMUX_PANE, points HOME and TMUX_TMPDIR at
the state, and puts a tmux shim first on PATH so every nested bare tmux call
reaches only that socket.  The state is removed afterwards unless --keep is
given.

Cleanup and every operation on an existing state refuse to touch anything that
fails the ownership check in tmux_guard: a direct child of the temporary
directory named dotfiles-tmux-sandbox.<id>, mode 0700 and owned by this user,
with a state.json recording exactly this socket.  A directory that merely looks
like a sandbox is not enough.
"""

import argparse
import json
import os
import secrets
import shutil
import subprocess
import sys
import time

# The scripts are symlinked from the repo; never write __pycache__ into it.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "lib"))

try:
    from tmux_guard import (  # noqa: E402
        SOCKET_RELPATH,
        STATE_FILE,
        STATE_PREFIX,
        STATE_VERSION,
        canonicalize,
        default_tmpdir,
        owned_socket_for_state,
    )
except Exception as exc:  # noqa: BLE001 - the runner must fail closed, never exit 1
    print(f"tmux-sandbox: cannot load the tmux_guard core: {exc}", file=sys.stderr)
    sys.exit(2)

SHIM = """#!/bin/sh
# Generated by tmux-sandbox: route nested tmux calls to the owned sandbox
# socket and refuse any attempt to override it.
if [ -z "${TMUX_TEST_SOCKET:-}" ] || [ -z "${REAL_TMUX:-}" ]; then
    echo "tmux-sandbox shim: TMUX_TEST_SOCKET/REAL_TMUX are not set; refusing to run" >&2
    exit 87
fi
for arg in "$@"; do
    case "$arg" in
        -S*|-L*)
            echo "tmux-sandbox shim: refusing socket override '$arg'; nested calls are already routed to the sandbox socket" >&2
            exit 87
            ;;
    esac
done
exec "$REAL_TMUX" -S "$TMUX_TEST_SOCKET" "$@"
"""


def fail(message, code=2):
    print(f"tmux-sandbox: {message}", file=sys.stderr)
    return code


def resolve_tmux():
    path = shutil.which("tmux")
    return os.path.realpath(path) if path else None


def new_state(tmpdir=None):
    root = canonicalize(tmpdir) if tmpdir else default_tmpdir()
    if not os.path.isdir(root):
        raise SystemExit(fail(f"temporary directory does not exist: {root}"))
    # sockaddr_un.sun_path is 104 bytes including the terminator on macOS and
    # most Linux systems; leave the real socket path under 104 bytes.
    if len(os.path.join(root, STATE_PREFIX + "0" * 8, SOCKET_RELPATH).encode()) > 103:
        raise SystemExit(
            fail(
                f"the temporary directory path is too long for a tmux socket: {root}; "
                "set TMPDIR to a shorter path"
            )
        )
    state = ""
    for _ in range(100):
        candidate = os.path.join(root, STATE_PREFIX + secrets.token_hex(4))
        try:
            os.mkdir(candidate, 0o700)
        except FileExistsError:
            continue
        state = candidate
        break
    if not state:
        raise SystemExit(fail(f"could not create a state directory under {root}"))
    os.chmod(state, 0o700)
    for name in ("run", "home", "tmp", "bin"):
        path = os.path.join(state, name)
        os.mkdir(path, 0o700)
        os.chmod(path, 0o700)
    socket = os.path.join(state, SOCKET_RELPATH)
    write_state(state, socket)
    shim = os.path.join(state, "bin", "tmux")
    with open(shim, "w", encoding="utf-8") as handle:
        handle.write(SHIM)
    os.chmod(shim, 0o755)
    return state, socket


def write_state(state, socket):
    payload = {
        "version": STATE_VERSION,
        "socket": socket,
        "runner": "tmux-sandbox",
        "created": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    path = os.path.join(state, STATE_FILE)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        json.dump(payload, handle, sort_keys=True)
        handle.write("\n")


def require_owned(state, tmpdir=None):
    socket = owned_socket_for_state(state, tmpdir)
    if socket is None:
        raise SystemExit(fail(f"refuse: {state} is not an owned sandbox state", 1))
    return socket


def sandbox_env(state, socket):
    real_tmux = resolve_tmux()
    if real_tmux is None:
        raise SystemExit(fail("tmux not found on PATH"))
    env = dict(os.environ)
    for name in ("TMUX", "TMUX_PANE"):
        env.pop(name, None)
    env["HOME"] = os.path.join(state, "home")
    env["TMUX_TMPDIR"] = os.path.join(state, "tmp")
    env["TMUX_TEST_SOCKET"] = socket
    env["REAL_TMUX"] = real_tmux
    env["PATH"] = os.path.join(state, "bin") + os.pathsep + env.get("PATH", "")
    return env


def kill_owned_server(socket):
    """Kill the server on an already-verified owned socket, if it is running.

    A tmux server can leave the socket file behind when it exits, so a stale
    path inside the owned state is removed after confirming nothing answers.
    """
    if not os.path.exists(socket):
        return True
    real_tmux = resolve_tmux()
    if real_tmux is None:
        return False
    env = dict(os.environ)
    for name in ("TMUX", "TMUX_PANE"):
        env.pop(name, None)

    def tmux(*args):
        return subprocess.run(
            [real_tmux, "-S", socket, *args],
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
        )

    tmux("kill-server")
    deadline = time.monotonic() + 5
    while os.path.exists(socket):
        if time.monotonic() >= deadline:
            break
        time.sleep(0.05)
    if not os.path.exists(socket):
        return True
    if tmux("list-sessions").returncode == 0:
        return False
    try:
        os.unlink(socket)
    except OSError:
        return False
    return True


def cleanup(state, tmpdir=None):
    socket = require_owned(state, tmpdir)
    if not kill_owned_server(socket):
        return fail(f"could not kill the server on {socket}; leaving {state} in place", 1)
    shutil.rmtree(state)
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(
        prog="tmux-sandbox",
        description="Private tmux servers for tests, with owned-socket cleanup.",
    )
    sub = parser.add_subparsers(dest="action", required=True)

    sub.add_parser("new", help="create a state directory and print it")

    path_parser = sub.add_parser("path", help="print the socket path of an owned state")
    path_parser.add_argument("--state", required=True, metavar="DIR")

    run_parser = sub.add_parser("run", help="run a command inside a sandbox")
    run_parser.add_argument("--state", metavar="DIR", help="reuse an owned state")
    run_parser.add_argument("--keep", action="store_true", help="keep the state afterwards")
    run_parser.add_argument("command", nargs=argparse.REMAINDER, metavar="CMD")

    cleanup_parser = sub.add_parser("cleanup", help="kill an owned server and remove its state")
    cleanup_parser.add_argument("--state", required=True, metavar="DIR")

    args = parser.parse_args(argv)

    if args.action == "new":
        state, socket = new_state()
        print(state)
        return 0

    if args.action == "path":
        print(require_owned(canonicalize(args.state)))
        return 0

    if args.action == "cleanup":
        return cleanup(canonicalize(args.state))

    if args.action == "run":
        command = list(args.command)
        if command and command[0] == "--":
            command = command[1:]
        if not command:
            return fail("run needs a command after --")
        if args.state:
            state = canonicalize(args.state)
            socket = require_owned(state)
        else:
            state, socket = new_state()
        print(f"tmux-sandbox: state {state}", file=sys.stderr)
        if args.keep:
            print(state)
        status = 2
        try:
            proc = subprocess.run(command, env=sandbox_env(state, socket), check=False)
            status = proc.returncode
        finally:
            if not args.keep:
                cleaned = cleanup(state)
                if cleaned != 0 and status == 0:
                    status = cleaned
        return status

    return fail(f"unknown action: {args.action}")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as exc:  # noqa: BLE001 - fail closed on anything unexpected
        print(f"tmux-sandbox: internal error: {exc}", file=sys.stderr)
        sys.exit(2)
