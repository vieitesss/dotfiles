#!/bin/sh
# Run a command against a private, owned tmux server.
#
#   tmux-sandbox -- CMD [ARGS...]
#
# One instance creates a unique state directory under the real TMPDIR with its
# own socket, points HOME/TMUX_TMPDIR at it, unsets the inherited TMUX/TMUX_PANE,
# and puts a shim first on PATH so nested bare tmux calls reach only that socket.
# The shim refuses any leading global option (-S, -L, clustered -2S) while a
# subcommand's own flags such as `capture-pane -S` stay legal.  Server and state
# are removed on exit, and cleanup never takes a caller-supplied path.  Not a
# sandbox against a hostile agent: the real tmux binary by absolute path works.

set -eu

usage() {
    echo "usage: tmux-sandbox -- CMD [ARGS...]" >&2
    exit 2
}

case "${1:-}" in
    -h|--help)
        echo "usage: tmux-sandbox -- CMD [ARGS...]"
        exit 0
        ;;
    --) shift ;;
    *) usage ;;
esac
[ "$#" -gt 0 ] || usage

real_tmux=$(command -v tmux || true)
if [ -z "$real_tmux" ]; then
    echo "tmux-sandbox: tmux not found on PATH" >&2
    exit 2
fi
real_tmux=$(cd "$(dirname "$real_tmux")" && pwd -P)/$(basename "$real_tmux")

tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P)
state=$(mktemp -d "$tmp/dotfiles-tmux-sandbox.XXXXXXXX")
chmod 700 "$state"
socket=$state/run/tmux.sock
mkdir "$state/run" "$state/home" "$state/tmp" "$state/bin"
chmod 700 "$state"/run "$state"/home "$state"/tmp "$state"/bin
ln -s "$real_tmux" "$state/bin/tmux.real"

cat > "$state/bin/tmux" <<'SHIM'
#!/bin/sh
# Generated by tmux-sandbox: route nested bare tmux calls to this state's
# private socket.  A leading global option, including a clustered socket
# selector such as -2S, is refused rather than reimplementing tmux's getopt.
state=$(cd "$(dirname "$0")/.." && pwd -P) || exit 87
if [ "${1:-}" != "${1#-}" ]; then
    echo "tmux-sandbox shim: refusing global option '${1}'; nested calls already use the sandbox socket" >&2
    exit 87
fi
exec "$state/bin/tmux.real" -S "$state/run/tmux.sock" "$@"
SHIM
chmod 755 "$state/bin/tmux"

cleaned=0
cleanup() {
    [ "$cleaned" = 0 ] || return 0
    cleaned=1
    if [ -e "$socket" ]; then
        "$real_tmux" -S "$socket" kill-server >/dev/null 2>&1 || true
    fi
    rm -rf "$state" || true
}
trap cleanup EXIT
trap 'exit 130' INT TERM HUP

echo "tmux-sandbox: state $state" >&2

# The command's own status exits the script and runs cleanup through the trap;
# every command in cleanup is guarded, so it cannot override that status.
(
    unset TMUX TMUX_PANE
    HOME=$state/home
    TMUX_TMPDIR=$state/tmp
    PATH=$state/bin:${PATH:-/usr/bin:/bin}
    export HOME TMUX_TMPDIR PATH
    "$@"
)
